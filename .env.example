# Copy to .env and change only the settings your stack uses.
# doctor.sh reads these known keys without executing this file.

# Hermes is optional for the reusable scripts. Set true only when your stack requires it.
HERMES_REQUIRED=false
HERMES_PROFILE=

# Optional local knowledge directory checked by doctor.sh.
VAULT_PATH=~/path/to/your/vault

# Default freshness window consumed by doctor.sh and verify.sh.
MAX_TASK_AGE_HOURS=48
